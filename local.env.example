# Local binary example for a Keeper instance that talks to a CPA server on localhost.
# Copy this file to .env.local and adjust values for your machine before running:
#   cpa-usage-keeper.exe --env .\.env.local

CPA_BASE_URL=http://127.0.0.1:8317
CPA_MANAGEMENT_KEY=replace-with-your-management-key

APP_PORT=18080
APP_BASE_PATH=

AUTH_ENABLED=true
LOGIN_PASSWORD=replace-with-your-login-password
AUTH_SESSION_TTL=168h

TZ=Asia/Shanghai
REDIS_QUEUE_ADDR=127.0.0.1:8317
REDIS_QUEUE_IDLE_INTERVAL=1s
REQUEST_TIMEOUT=30s

WORK_DIR=./data

LOG_LEVEL=info
LOG_FILE_ENABLED=true
LOG_RETENTION_DAYS=7

BACKUP_ENABLED=true
BACKUP_INTERVAL=24h
BACKUP_RETENTION_DAYS=7

QUOTA_AUTO_REFRESH_ENABLED=false
